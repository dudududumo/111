# Gemini AI API Key (可选，用于AI功能)
GEMINI_API_KEY="your_gemini_api_key_here"

# 应用URL
APP_URL="http://localhost:3000"

# API 基础URL（前端调用后端）
VITE_API_URL="http://localhost:3000/api"

# JWT 密钥（生产环境必须修改）
JWT_SECRET="your-secret-key-change-in-production"

# 数据库配置（开发环境使用SQLite，生产环境使用PostgreSQL）
# 开发环境不需要配置，自动使用 mental_health.db
# 生产环境PostgreSQL配置示例：
# DATABASE_URL="postgresql://user:password@localhost:5432/mental_health"

# 阿里云短信服务配置（可选，生产环境建议配置）
# ALIYUN_ACCESS_KEY_ID="your_access_key_id"
# ALIYUN_ACCESS_KEY_SECRET="your_access_key_secret"
# ALIYUN_SMS_SIGN_NAME="您的签名"
# ALIYUN_SMS_TEMPLATE_CODE="您的模板代码"
