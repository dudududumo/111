rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         request.auth.token.email == "kest6868@gmail.com");
    }

    function isPsychologist() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'psychologist';
    }

    function isDeptHead() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head';
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isPsychologist();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
    }

    // Assessments
    match /assessments/{assessmentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin() || isPsychologist();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }

    // Warnings
    match /warnings/{warningId} {
      allow read: if isOwner(resource.data.uid) || isAdmin() || isPsychologist() || isDeptHead();
      allow create: if isAdmin() || isPsychologist(); // Only system/admins create warnings
      allow update: if isAdmin() || isPsychologist() || isDeptHead();
    }

    // Risk Assessments
    match /risk_assessments/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isPsychologist();
      allow write: if isAdmin() || isPsychologist();
    }

    // Interventions
    match /interventions/{interventionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin() || isPsychologist();
      allow create: if isAdmin() || isPsychologist();
      allow update: if isAdmin() || isPsychologist();
    }

    // Community Posts (Anonymous)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])) ||
        (resource.data.authorId == request.auth.uid)
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Tool Usage (Anonymous for analysis)
    match /tool_usage/{usageId} {
      allow read: if isAdmin() || isPsychologist();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Personal Diary
    match /diaries/{diaryId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Personal Tasks
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Assessment Progress
    match /progress/{progressId} {
      allow read, write: if isAuthenticated() && progressId.matches(request.auth.uid + '_.*');
    }
  }
}
